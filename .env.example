# Copy to .env and set values as needed (optional — notebooks use defaults)

# train = full pipeline | predict = inference orchestrator
# AML_PIPELINE_MODE=train

# train = fit models | predict = score with saved bundles
# AML_RUN_MODE=train

# Override output directories (absolute paths recommended on Windows)
# AML_PHASE1_DIR=python_scripts/ml_outputs
# AML_PHASE2_DIR=python_scripts/phase2_outputs

# Inference input parquet
# AML_INFERENCE_INPUT=outputs_updated/inference_input.parquet
# AML_INPUT_FILE=outputs_updated/stg_transactions_features.parquet
